BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
ADMIN_IDS=7787565361
INFOBOX_WORK_DIR=.
INFOBOX_DB_PATH=infobox.db
LOG_LEVEL=INFO

# A private Drive folder plus OAuth offline credentials; never commit real values.
# Leave empty to keep local storage and warn admins on every startup.
INFOBOX_GOOGLE_DRIVE=
# Example (one line; replace placeholders):
# INFOBOX_GOOGLE_DRIVE={"folder_id":"FOLDER_ID","client_id":"CLIENT_ID","client_secret":"CLIENT_SECRET","refresh_token":"REFRESH_TOKEN","interval":30,"keep":5,"initialize_empty":false}
